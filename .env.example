# ================================
# CONFIGURAÇÃO GMAIL
# ================================

# Servidor IMAP do Gmail (não altere)
MAIL_SERVIDOR_GMAIL=imap.gmail.com

# Seu email do Gmail
# Exemplo: seu.email@gmail.com
MAIL_USER_GMAIL=seu.email@gmail.com

# Senha de Aplicativo do Gmail
# IMPORTANTE: Gere em https://myaccount.google.com/apppasswords
# NÃO use sua senha comum do Gmail
MAIL_SENHA_GMAIL=sua_senha_de_app_aqui

# ================================
# CONFIGURAÇÃO WHATSAPP
# ================================

# Número de telefone para receber os emails no WhatsApp
# Formato: 55 (código do país) + DDD + número
# Exemplo: 5511223344556
NUMERO_TELEFONE=55XXXXXXXXXX

